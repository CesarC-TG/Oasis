# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML files - force LF
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.glsl text eol=lf

# Unity-specific text formats
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.mask text eol=lf
*.mat text eol=lf
*.physicMaterial text eol=lf
*.guiskin text eol=lf
*.fontsettings text eol=lf
*.inputactions text eol=lf

# Config / data
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files - no processing
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tiff binary
*.psd binary
*.fbx binary
*.obj binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.dll binary
*.so binary
*.dylib binary
*.pdb binary
*.zip binary
*.7z binary
*.gz binary
*.rar binary
*.pdf binary
*.unitypackage binary
*.apk binary
*.aab binary
